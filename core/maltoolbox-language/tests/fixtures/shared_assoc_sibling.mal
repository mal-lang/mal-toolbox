// vim:ft=mal
#id: "test"
#version: "0.0.0"

category Test{
  abstract asset Base {
  }

  asset SiblingA extends Base {
    | onlyA
      -> target.reach
  }

  asset SiblingB extends Base {
  }

  asset Target {
    | reach
  }
}

associations {
  Base [base] * <-- BaseTarget --> * [target] Target
}
