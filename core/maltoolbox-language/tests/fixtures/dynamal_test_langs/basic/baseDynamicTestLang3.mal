#id: "baseDynamicTestLang3"
#version: "0.1.0"
category baseDynamicTestLang3 {
	asset Bowl {
		| access
			-> addApple, removeApple

		| addApple
			A> self / apples

		| removeApple
			R> self / apples
	}

	asset Apple {}

}

associations {
	Bowl [container] 1 <-- contains --> * [apples] Apple

}
