#id: "baseDynamicTestLang9"
#version: "0.0.1"


category Business {
	asset Plantation {
		| access
			-> plantTree

		| plantTree
			A> self / trees ^ trees.bananas
		
	}

	asset BananaTree{}
	asset Banana {}
}

associations {
	Plantation [plant] 1 <-- cultivate --> * [trees] BananaTree
	BananaTree [tree] 1 <-- contains --> * [bananas] Banana
}
