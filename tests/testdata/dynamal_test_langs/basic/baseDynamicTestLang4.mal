#id: "baseDynamicTestLang4"
#version: "0.1.0"
category baseDynamicTestLang4 {
	asset Bowl {
		| access
			-> tamper

		| tamper
			A> self / apples
			R> self / apples
	}

	asset Apple {}

}

associations {
	Bowl [container] 1 <-- contains --> * [apples] Apple

}
