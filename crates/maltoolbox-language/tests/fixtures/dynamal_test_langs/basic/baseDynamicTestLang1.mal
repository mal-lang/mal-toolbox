#id: "baseDynamicTestLang1"
#version: "0.1.0"
category baseDynamicTestLang1 {
	asset Bowl {
		| access
			-> addApple

		| addApple
			A> self / apples
	}

	asset Apple {}

}

associations {
	Bowl [container] 1 <-- contains --> * [apples] Apple

}
